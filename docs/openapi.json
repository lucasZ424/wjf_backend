            }
          },
          {
            "name": "seconds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 31622400,
              "exclusiveMinimum": 0,
              "title": "Seconds"
            }
          },
          {
            "name": "points",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "title": "Points"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1,
              "default": 10000,
