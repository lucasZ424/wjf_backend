    "/api/snapshot": {
      "get": {
        "summary": "Snapshot",
        "description": "What the live pages show (修复轮05): the owner's whole current state, read at once on the event loop - no\nawait between its parts, no database, no waiting for new data.  Never cached: every reading is a new one.",
        "operationId": "snapshot_api_snapshot_get",
        "responses": {
          "200": {
            "description": "The whole current state",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "taken_time": {
                      "type": "number",
                      "description": "When this reading was taken from the owner (the live trend's time); not an observation time"
                    },
                    "run_id": {
                      "type": "string"
                    },
                    "channels": {
                      "additionalProperties": {
                        "properties": {
                          "kind": {
                            "type": "string"
                          },
                          "value": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "valid": {
                            "type": "boolean"
                          },
                          "time": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "observation_id": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Inputs only: the observation shown, so a new sample is told from one already shown"
                          },
                          "origin": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Inputs only: a receipt or a restatement of an earlier observation"
                          }
                        },
                        "type": "object",
                        "description": "One channel; an input also names its current observation."
                      },
                      "type": "object",
                      "description": "Per channel id: value, quality, validity, observation time and fault state, as the page must show them."
                    },
                    "status": {
                      "type": "object",
                      "description": "The owner's source and fault state."
                    },
                    "archive_target": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "PRIMARY",
                        "EMERGENCY",
                        "PRIMARY_PROVISIONAL",
                        "UNKNOWN",
                        null
                      ],
                      "description": "Where new groups go (§13.5, §13.6): PRIMARY_PROVISIONAL while the routing state cannot be read, UNKNOWN while it cannot and the groups wait; null without an archive"
                    }
                  },
                  "type": "object",
                  "description": "The whole current state, taken in one synchronous read of the owner (终版 §13.3); memory only, never cached."
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "What the self-check and communication pages show besides the live state: archive, writer queue, negotiated\nparameters, each source's resync and connect-failure counts, the run's communication log and the input table.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Health and communication state",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "properties": {
                        "sources": {
                          "additionalProperties": {
                            "properties": {
                              "resync_count": {
                                "type": "integer",
                                "description": "Entries into RESYNC since the last stable spell of valid communication"
                              },
                              "persistent_resync": {
                                "type": "boolean",
                                "description": "resync_count reached the persistent threshold (5)"
                              },
                              "connect_failures": {
                                "type": "integer",
                                "description": "Failed connect attempts since the public connect last succeeded (0: none yet)"
                              }
                            },
                            "type": "object",
                            "description": "State, alarm, archive state and last communication of one source."
                          },
                          "type": "object",
                          "description": "Per source id."
                        }
                      },
                      "type": "object",
                      "description": "The owner's source and fault state; each source also carries the acquirer's `connect_failures`."
                    },
                    "archive": {
                      "properties": {
                        "routing": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "The routing mode (PRIMARY / EMERGENCY / UNKNOWN), not where groups go"
                        },
                        "target": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Where new groups go, the same as the snapshot's `archive_target`"
                        }
                      },
                      "type": "object",
                      "description": "Archive routing, writer queue and per-source archive state."
                    },
                    "negotiated": {
                      "type": "object",
                      "description": "What the OPC UA server really granted, per source (unchanged shape)."
                    },
                    "runtime": {
                      "type": "object",
                      "description": "Runtime flags."
                    },
                    "communication": {
                      "properties": {
                        "taken_time": {
                          "type": "number",
                          "description": "When this response was taken from the owner; not an observation time"
                        },
                        "log": {
                          "properties": {
                            "scope": {
                              "type": "string"
                            },
                            "limit": {
                              "type": "integer"
                            },
                            "evicted": {
                              "type": "integer",
                              "description": "Entries moved out of the log (first in, first out)"
                            },
                            "oldest_time": {
                              "type": [
                                "number",
                                "null"
                              ],
                              "description": "Discovery time of the oldest entry still held"
                            },
                            "diag_lost": {
                              "type": "integer",
                              "description": "Diagnostic facts refused at the ordered entry; not a data loss"
                            },
                            "incomplete": {
                              "type": "boolean"
                            },
                            "entries": {
                              "items": {
                                "properties": {
                                  "seq": {
                                    "type": "integer"
                                  },
                                  "source_id": {
                                    "type": "string"
                                  },
                                  "kind": {
                                    "type": "string"
                                  },
                                  "event": {
                                    "type": "string"
                                  },
                                  "reason": {
                                    "type": "string"
                                  },
                                  "conn_gen": {
                                    "type": [
                                      "integer",
                                      "null"
                                    ]
                                  },
                                  "phase": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "detail": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "detail_truncated": {
                                    "type": "boolean"
                                  },
                                  "found_time": {
                                    "type": "number"
                                  },
                                  "last_comm_time": {
                                    "type": [
                                      "number",
                                      "null"
                                    ]
                                  },
                                  "first_failure": {
                                    "type": [
                                      "number",
                                      "null"
                                    ]
                                  },
                                  "last_failure": {
                                    "type": [
                                      "number",
                                      "null"
                                    ]
                                  },
                                  "count": {
                                    "type": "integer"
                                  },
                                  "state": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "ended_time": {
                                    "type": [
                                      "number",
                                      "null"
                                    ]
                                  },
                                  "end_reason": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  }
                                },
                                "type": "object",
                                "description": "One log entry; `state` is ACTIVE / ENDED for repeated failures, empty for a single event."
                              },
                              "type": "array"
                            }
                          },
                          "type": "object",
                          "description": "This run's communication log, in memory, at most `limit` entries, oldest first."
                        },
                        "inputs": {
                          "items": {
                            "properties": {
                              "point_id": {
                                "type": "string"
                              },
                              "source_id": {
                                "type": "string"
                              },
                              "observation_id": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "value": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              },
                              "quality": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "status_code": {
                                "type": [
                                  "integer",
                                  "null"
                                ]
                              },
                              "received_time": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              },
                              "source_time": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "description": "As the server gave it (OPC UA only); judges nothing"
                              },
                              "valid": {
                                "type": "boolean",
                                "description": "Validity at the moment of the response"
                              },
                              "reason": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "type": "object",
                            "description": "observation_id, value, quality, status_code, received_time and source_time all belong to the same observation."
                          },
                          "type": "array",
                          "description": "Every input, one row each; a row is taken whole from ONE observation."
                        }
                      },
                      "type": "object",
                      "description": "What the communication page shows."
                    }
                  },
                  "type": "object",
                  "description": "Memory only: nothing here reads the database or asks a device."
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
